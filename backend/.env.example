# AetherSound Backend - Environment Configurations
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# MongoDB Configuration (Leave blank to use Local JSON Database Fallback)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aethersound

# Stripe Configurations (Leave blank to use Simulated Stripe Payment UI)
STRIPE_SECRET_KEY=sk_test_...
